# ============================================================
# ElectroVerse - root .gitignore
# ============================================================

# Java / Spring Boot build output
backend/target/
target/
*.class

# Frontend dependencies and build output
frontend/node_modules/
node_modules/
frontend/dist/
dist/
dist-ssr/
.vite/
*.local

# Environment files and secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Generated runtime credentials (written by DataSeeder, see README)
admin-credentials.txt

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws

# Operating system files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
