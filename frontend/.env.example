# Base URL of the ElectroVerse Spring Boot backend API.
# When running `npm run dev`, the Vite dev server proxies /api to http://localhost:8080,
# so the default of /api/v1 works without CORS. To call the backend directly, set the
# full URL, e.g. VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=/api/v1
